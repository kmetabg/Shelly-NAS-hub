# ──────────────────────────────────────────────────────────────────────────
# Shelly NAS Hub — Camera Configuration
# ──────────────────────────────────────────────────────────────────────────
# Copy to `.env` and customize. After first start, the following NVR_*
# variables are seeded into the SQLite camera registry — further changes
# happen through the UI (Settings → Cameras).
# ──────────────────────────────────────────────────────────────────────────

TZ=Europe/Sofia

# ── (Optional) Initial NVR seeding (Dahua-compatible NVR/DVR) ─────────────
# Leave empty if you have no NVR/DVR — you can still add Shelly + RTSP
# cameras through the UI after first start.
NVR_HOST=
NVR_USER=admin
NVR_PASSWORD=
NVR_CHANNELS=1,2
NVR_NAMES=Camera 1,Camera 2

# ── AI Detection (YOLO + InsightFace) ─────────────────────────────────────
NVR_DETECT_ENABLED=true
NVR_DETECT_MODEL=yolo26s.pt          # yolo26{n,s,m,l,x}.pt or yolov8{n,s,m,l,x}.pt
NVR_DETECT_INTERVAL=3                # seconds between camera scans
NVR_DETECT_COOLDOWN=30               # seconds between events for same camera
NVR_DETECT_CLASSES=0,2,3,7,15,16     # COCO IDs: person,car,motorcycle,truck,cat,dog
NVR_DETECT_CONFIDENCE=0.45
NVR_DETECT_RETENTION=7               # days to keep detection events

# ── 24/7 Continuous Recording ─────────────────────────────────────────────
RECORDING_ENABLED=true
RECORDING_RETENTION_DAYS=7           # default; override per-camera in UI
RECORDING_SEGMENT_S=60               # one MP4 file per minute
RECORDING_QUALITY=main               # main | sub
RECORDING_AUDIO=true
RECORDING_DISK_LIMIT_PCT=90          # auto-shrink retention when usage exceeds

# ── Authentication (single-user, optional) ────────────────────────────────
# Default: disabled — UI is fully public. Enable to require sign-in.
#   Generate password hash:
#     python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
#   Generate session secret:
#     python3 -c "import secrets; print(secrets.token_hex(32))"
#
#   IMPORTANT: bcrypt hashes contain `$` — wrap in single quotes in .env:
#     HOMEHUB_AUTH_PASSWORD_HASH='$2b$12$abcdef...'
HOMEHUB_AUTH_ENABLED=false
HOMEHUB_AUTH_USER=admin
HOMEHUB_AUTH_PASSWORD_HASH=
HOMEHUB_AUTH_SECRET=
HOMEHUB_AUTH_SESSION_TTL_HOURS=720   # 30 days
